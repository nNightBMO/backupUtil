# Необязательные настройки (то же можно задать в TUI: ./backup.sh tui → «Параметры»).
# Скопируйте в backup.env — файл подключается через `source`: без кавычек, обратных слешей и $( ) в значениях.
VOLUME_SIZE="1800M"     # размер тома (Telegram: файл должен быть < 2 ГБ)
ZSTD_LEVEL=3            # 1 быстро … 19 сильно; 3 — разумный баланс
SPLIT=1                 # 0 — один файл вместо томов
ONE_FS=0                # 1 — не заходить в другие ФС / btrfs-subvolume

# Шифрование (age). Ключ создаётся один раз:
#   age-keygen -o .secrets/age.key      # выведет "Public key: age1..."
#   chmod 600 .secrets/age.key
# Сюда — ТОЛЬКО публичный ключ; приватный храните отдельно (менеджер паролей, флешка)!
AGE_RECIPIENT=""        # age1xxxxxxxx…
#AGE_RECIPIENTS_FILE="$HOME/keys/recipients.txt"
