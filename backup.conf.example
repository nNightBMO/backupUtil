# Список директорий для бэкапа. Одна строка — одна директория.
# Формат:   путь [ | имя_папки [ | опции ] ]
#   имя_папки — подпапка в ~/backupUtil/ (и топик в Telegram, регистр не важен);
#               по умолчанию = последнее имя из пути (~/.config → .config)
#   опции     — через запятую:
#       encrypt  зашифровать age перед нарезкой на тома
#       sudo     читать через sudo (для путей вне $HOME включается само)
#       whole    собрать ВСЮ директорию в один архив
#                (по умолчанию каждый элемент директории — отдельный архив)
# Пути: ~ и $HOME раскрываются, пробелы и юникод допустимы. Строки с # — комментарии.

~/Documents
~/Pictures
~/code
~/.config      |   | whole
~/.local/share | local-share
~/.ssh         |   | encrypt,whole
~/.gnupg       |   | encrypt,whole

# Системные пути (читаются через sudo, результат всё равно принадлежит вашему пользователю)
/etc           |   | whole
/opt

# Если у двух путей совпадают последние имена — задайте имя явно:
# ~/work/docs | work-docs
